# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA publique o arquivo ".env" real no repositório.

# Banco de dados (SQLite por padrão; troque a URL para usar PostgreSQL, por exemplo)
DATABASE_URL=sqlite:///./tarefas.db

# Chave usada para assinar os tokens JWT. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Validade do token, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens autorizadas pelo CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
